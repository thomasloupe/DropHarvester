<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless entrypoint: runs the shared DropHarvester.Core harvesting engine as a background service,
       for Docker / "run it as a service". No MAUI, no UI - device-code auth happens via the logs and
       state persists to a mounted data volume. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DropHarvester.Daemon</RootNamespace>
    <AssemblyName>DropHarvester.Daemon</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Smaller, dependency-light container (no ICU needed); the engine only uses ordinal/invariant. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.23.1</Version>
    <InformationalVersion>1.23.1</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DropHarvester.Core\DropHarvester.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
