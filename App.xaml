<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DropHarvester"
             xmlns:conv="clr-namespace:DropHarvester.Converters"
             x:Class="DropHarvester.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Converters ===== -->
            <conv:InvertedBoolConverter x:Key="InvertBool" />
            <conv:BoolToColorConverter x:Key="BoolToColor" />
            <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
            <conv:IntIsZeroConverter x:Key="IntIsZero" />
            <conv:IntIsPositiveConverter x:Key="IntIsPositive" />
            <conv:RewardTypeToColorConverter x:Key="RewardTypeColor" />

            <!-- ===== DropHarvester dark palette (Twitch purple accent) ===== -->
            <Color x:Key="DhBg">#0E0F13</Color>
            <Color x:Key="DhSurface">#181A22</Color>
            <Color x:Key="DhSurface2">#20232E</Color>
            <Color x:Key="DhBorder">#2C3040</Color>
            <Color x:Key="DhText">#F1F2F5</Color>
            <Color x:Key="DhMuted">#9BA1B0</Color>
            <Color x:Key="DhAccent">#9146FF</Color>
            <Color x:Key="DhAccentDim">#5C3A9E</Color>
            <Color x:Key="DhGold">#E7B53C</Color>
            <Color x:Key="DhGreen">#43B581</Color>
            <Color x:Key="DhRed">#E03A2F</Color>
            <Color x:Key="DhBlue">#4C8DFF</Color>

            <!-- ===== Shared styles ===== -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource DhSurface}" />
                <Setter Property="Stroke" Value="{StaticResource DhBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource DhAccent}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource DhSurface2}" />
                <Setter Property="TextColor" Value="{StaticResource DhText}" />
                <Setter Property="BorderColor" Value="{StaticResource DhBorder}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="42" />
            </Style>

            <!-- Left-hand settings navigation link. -->
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource DhMuted}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource DhSurface2}" />
                                    <Setter Property="TextColor" Value="{StaticResource DhText}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource DhMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="2" />
            </Style>

            <Style x:Key="H1" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource DhText}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="Body" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource DhText}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="Muted" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource DhMuted}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
