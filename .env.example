# DropHarvester daemon configuration. Copy to `.env` (docker compose reads it automatically) and edit.
# Every value is optional; anything set here WINS over settings.json on the data volume.

# ---- Which games to harvest ----
# Comma-separated exact game names, in order of preference.
# DH_PRIORITY_GAMES=Rust,Fortnite,Valorant
# Never harvest these.
# DH_EXCLUDE_GAMES=Just Chatting
# Skip drops whose reward you already own (opt-in per game).
# DH_DEDUPE_GAMES=
# Harvest these even when your account isn't linked to the drops program (lowest priority).
# DH_HARVEST_UNLINKED_GAMES=
# Harvest ONLY the priority list, ignore everything else. (1/true/0/false)
# DH_PRIORITY_ONLY=false
# Order eligible campaigns by soonest-ending instead of priority position.
# DH_ENDING_SOONEST=false
# Tiebreaker: when campaigns are otherwise tied, prefer the game with fewer live drops-enabled streamers.
# DH_AVAILABILITY_PRIORITY=false
# Also auto-claim the channel-points bonus chest on the watched channel.
# DH_CLAIM_CHANNEL_POINTS=false

# ---- Preferred / avoided channels (logins) ----
# DH_PREFERRED_CHANNELS=
# DH_AVOIDED_CHANNELS=

# ---- Remote alerts (Discord / Slack / generic webhook) ----
# Setting a URL enables webhooks.
# DH_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
# Discord | Slack | Generic
# DH_WEBHOOK_KIND=Discord
# Which events to alert on (comma list, or "all"):
#   drop-claimed, campaign-complete, all-harvested, new-drop, login-expired
# DH_WEBHOOK_EVENTS=drop-claimed,campaign-complete,login-expired

# ---- Networking / misc ----
# HTTP/HTTPS/SOCKS proxy for all Twitch traffic.
# DH_PROXY=
# Health/status HTTP port inside the container (also update the compose port mapping if you change it).
# DH_HEALTH_PORT=8080
# Serve /healthz + /status at all.
# DH_HEALTH_ENABLED=true
# Rich debug endpoints (/snapshot per-campaign decisions, /log, /claims-raw). Off by default; when on
# it's exposed on 0.0.0.0:DH_DEBUG_SERVER_PORT (map the port in compose to reach it from the host).
# DH_DEBUG_SERVER=false
# DH_DEBUG_SERVER_PORT=5757
# Log verbosity: Trace | Debug | Information | Warning | Error
# DH_LOG_LEVEL=Information
# Where state is stored inside the container (leave as-is; the volume mounts here).
# DROPHARVESTER_DATA=/data
