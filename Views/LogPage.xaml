<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DropHarvester.ViewModels"
             xmlns:loc="clr-namespace:DropHarvester.Localization"
             x:Class="DropHarvester.Views.LogPage"
             x:DataType="vm:LogViewModel"
             Title="Log"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource DhBg}">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
            <Button Text="{Binding CopyLabel}" Style="{StaticResource GhostButton}"
                    MinimumWidthRequest="110" Command="{Binding CopyCommand}" />
            <Button Text="{loc:Tr Log_Clear}" Style="{StaticResource GhostButton}"
                    MinimumWidthRequest="100" Command="{Binding ClearCommand}" />
        </HorizontalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <!-- Each line is its own container appended to the stack (via BindableLayout), so a new line is
                 added at the end instead of the whole list re-rendering (the CollectionView jank). Odd rows
                 get a subtle zebra background for readability. LogStack.SizeChanged (code-behind) keeps the
                 view following the newest line. -->
            <ScrollView x:Name="LogScroll" Padding="4">
                <VerticalStackLayout x:Name="LogStack" Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Lines}">
                    <BindableLayout.EmptyView>
                        <Label Text="{loc:Tr Log_NoLogOutputYet}" Style="{StaticResource Muted}" Padding="8" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogLine">
                            <Grid BackgroundColor="{Binding RowBackground}" Padding="8,3">
                                <Label Text="{Binding Text}" TextColor="{Binding Color}"
                                       FontSize="12" FontFamily="OpenSansRegular" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
